# ─── Database ─────────────────────────────────────────────────
DATABASE_URL="postgresql://kairox:kairox_dev@localhost:5432/kairox_db?schema=public"

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Auth.js ──────────────────────────────────────────────────
